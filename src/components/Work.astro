---
/**
 * The section creators scan first, so it leads with the video and keeps the
 * words underneath it short.
 *
 * Nothing loads until someone asks for it. A single Instagram embed weighs
 * roughly 600KB, so four of them left to load on their own would spend most of
 * a visitor's patience before they had seen a frame. The card renders a cover
 * (or a typographic panel when there is no cover yet), and the iframe is built
 * on click.
 */
import { Image } from 'astro:assets';
import { reels, copy } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="work" aria-labelledby="work-heading">
  <div class="container">
    <SectionHeading
      id="work-heading"
      time={copy.work.time}
      eyebrow={copy.work.eyebrow}
      title={copy.work.title}
    />

    <ul class="grid">
      {
        reels.map((reel, i) => (
          <li
            class:list={['card', 'reveal']}
            style={`--reveal-delay: ${i * 90}ms; --tilt: ${[-1.5, 1, -1, 1.5][i % 4]}deg`}
          >
            <div class="card__media" data-media>
              {reel.cover ? (
                <Image
                  class="card__cover"
                  src={reel.cover}
                  alt={`Cover frame from ${reel.title}`}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 960px) 22rem, (min-width: 640px) 45vw, 90vw"
                  loading="lazy"
                />
              ) : (
                /* No cover supplied yet. A typographic panel is honest about
                   that and still reads as part of the design, where a stock
                   image would be pretending. */
                <div class="card__placeholder">
                  <span class="card__ratio">9:16</span>
                  <span class="card__placeholderText">{reel.format}</span>
                </div>
              )}

              <button
                type="button"
                class="play"
                data-play
                data-embed={reel.embedCode}
                data-title={reel.title}
              >
                <span class="play__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 4.5v15l13-7.5z" />
                  </svg>
                </span>
                <span class="visually-hidden">Play {reel.title} for {reel.client}</span>
              </button>
            </div>

            <div class="card__body">
              <h3 class="card__title">{reel.title}</h3>

              <p class="card__client">
                {reel.client} <span class="card__size">{reel.clientSize}</span>
              </p>

              <ul class="tags" aria-label={`Tags for ${reel.title}`}>
                {reel.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>

              {reel.result && <p class="card__result">{reel.result}</p>}

              {/* Always reachable, even if the embed is blocked or fails. */}
              <a class="card__link" href={reel.url} target="_blank" rel="noopener noreferrer">
                {copy.work.openLink}
                <span class="visually-hidden"> (opens in a new tab)</span>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M6 3h7v7M13 3 3.5 12.5" />
                </svg>
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="cta reveal">
      <p class="cta__text">{copy.work.ctaText}</p>
      <a class="button" href="#contact">{copy.work.ctaButton}</a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    background-color: var(--surface);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    transform: rotate(var(--tilt));
    transition: transform var(--duration) var(--ease-expo-out),
      box-shadow var(--duration) var(--ease-expo-out);
  }

  .card:hover,
  .card:focus-within {
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }

  .card__media {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--border);
    background-color: var(--bg-elevated);
  }

  /* Once the embed is in, Instagram's own chrome sits above and below the
     video, so the box has to grow past the 9:16 of the video itself. */
  .card__media.is-live {
    aspect-ratio: 9 / 20;
  }

  .card__media.is-live :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__placeholder {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: var(--space-4);
    color: var(--fg-muted);
  }

  /* Cycling the panel grounds keeps a row of four identical placeholders from
     reading as one flat block. Sage takes ink rather than muted text: muted
     only reaches 3.4:1 against it. */
  .card:nth-child(4n + 2) .card__placeholder {
    background-color: var(--sage);
    color: var(--sage-ink);
  }

  .card:nth-child(4n + 3) .card__placeholder {
    background-color: var(--surface);
  }

  .card__ratio,
  .card__placeholderText {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: inherit;
    font-variant-numeric: tabular-nums;
  }

  /* --- Play control --- */
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background-color: transparent;
    border: 0;
    cursor: pointer;
  }

  .play__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    background-color: var(--accent);
    color: var(--accent-contrast);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    transition: transform var(--duration-fast) var(--ease-quart-out);
  }

  .play:hover .play__icon {
    transform: scale(1.08);
  }

  .play:active .play__icon {
    transform: scale(0.96);
  }

  .play__icon svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  /* --- Body --- */
  .card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .card__client {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .card__size {
    font-weight: 400;
    color: var(--fg-subtle);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: 2px var(--space-3);
    border: var(--border-width) solid var(--border);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  /* The outcome line is the one that wins the enquiry, so it gets the fill. */
  .card__result {
    padding: var(--space-2) var(--space-3);
    background-color: var(--sage);
    color: var(--sage-ink);
    border: var(--border-width) solid var(--border);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-ink);
    transition: gap var(--duration-fast) var(--ease-quart-out);
  }

  .card__link svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card__link:hover {
    gap: var(--space-3);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--border-width) dashed var(--border);
  }

  .cta__text {
    font-family: var(--font-display), Impact, sans-serif;
    font-size: var(--text-h3);
    text-transform: uppercase;
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Click-to-load embeds. The iframe is created here and nowhere else, so the
  // page ships with no third-party video weight at all until someone asks.
  // ---------------------------------------------------------------------------
  const players = document.querySelectorAll<HTMLButtonElement>('[data-play]');

  for (const button of players) {
    button.addEventListener('click', () => {
      const code = button.dataset.embed;
      const media = button.closest<HTMLElement>('[data-media]');
      if (!code || !media) return;

      const frame = document.createElement('iframe');
      frame.src = `https://www.instagram.com/reel/${code}/embed/`;
      frame.title = button.dataset.title ?? 'Instagram reel';
      frame.loading = 'lazy';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.setAttribute('allowfullscreen', '');
      frame.setAttribute('scrolling', 'no');

      media.replaceChildren(frame);
      media.classList.add('is-live');
      // Focus was on the button we just removed, so move it to the player to
      // keep keyboard users from being dropped back at the top of the page.
      frame.setAttribute('tabindex', '-1');
      frame.focus();
    });
  }
</script>
