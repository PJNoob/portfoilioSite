---
/**
 * Direct links first, form second — people generally prefer messaging you to
 * filling in a form. The form is a convenience, not the only route.
 *
 * The fields are the ones needed to quote: whose channel, what kind of video,
 * and how much of it. Anything that would not change the price is not asked.
 *
 * There is no backend by default: submitting composes a prefilled mailto:
 * link. Set FORM_ENDPOINT in src/data/profile.ts to post somewhere real.
 */
import { profile, socials, enquiry, copy, FORM_ENDPOINT } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section class="section section--navy" id="contact" aria-labelledby="contact-heading">
  <span class="contact__watermark" aria-hidden="true">Say Hello</span>
  <div class="container">
    <SectionHeading
      id="contact-heading"
      eyebrow={copy.contact.eyebrow}
      title={copy.contact.title}
    />

    <div class="contact">
      <div class="contact__direct reveal">
        <p class="contact__lead">{copy.contact.lead}</p>

        <div class="email-row">
          <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button type="button" class="copy" data-copy-email data-email={profile.email}>
            <span data-copy-label>{copy.contact.copyButton}</span>
          </button>
          {/* Announces the copy result to screen readers without stealing focus. */}
          <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
        </div>

        <ul class="socials">
          {
            socials.map((social) => (
              <li>
                <a
                  class="social"
                  href={social.href}
                  {...(social.href.startsWith('mailto:')
                    ? {}
                    : { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  <span class="social__label">{social.label}</span>
                  <span class="social__handle">{social.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        class="form reveal"
        style="--reveal-delay: 120ms"
        data-contact-form
        data-copy-idle={copy.contact.copyButton}
        data-copy-done={copy.contact.copiedButton}
        data-copy-failed={copy.contact.notes.copyFailed}
        data-err-name={copy.contact.errors.name}
        data-err-email={copy.contact.errors.email}
        data-err-email-invalid={copy.contact.errors.emailInvalid}
        data-err-channel={copy.contact.errors.channelInvalid}
        data-err-message={copy.contact.errors.message}
        data-note-sending={copy.contact.notes.sending}
        method={FORM_ENDPOINT ? 'POST' : undefined}
        action={FORM_ENDPOINT ?? undefined}
        novalidate
      >
        <div class="field">
          <label for="contact-name">{copy.contact.labels.name}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            aria-describedby="contact-name-error"
          />
          <p class="error" id="contact-name-error" data-error-for="name"></p>
        </div>

        <div class="field">
          <label for="contact-email">{copy.contact.labels.email}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-describedby="contact-email-error"
          />
          <p class="error" id="contact-email-error" data-error-for="email"></p>
        </div>

        <div class="field">
          <label for="contact-channel">{copy.contact.labels.channel}</label>
          <input
            id="contact-channel"
            name="channel"
            type="url"
            inputmode="url"
            placeholder={copy.contact.labels.channelPlaceholder}
            aria-describedby="contact-channel-error"
          />
          <p class="error" id="contact-channel-error" data-error-for="channel"></p>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="contact-format">{copy.contact.labels.format}</label>
            <select id="contact-format" name="format">
              {enquiry.formats.map((format) => <option value={format}>{format}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="contact-volume">{copy.contact.labels.volume}</label>
            <select id="contact-volume" name="volume">
              {enquiry.volumes.map((volume) => <option value={volume}>{volume}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="contact-message">{copy.contact.labels.message}</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            aria-describedby="contact-message-error"></textarea>
          <p class="error" id="contact-message-error" data-error-for="message"></p>
        </div>

        <button class="button" type="submit">{copy.contact.submit}</button>

        <p class="form__note" role="status" aria-live="polite" data-form-status>
          {
            FORM_ENDPOINT ? copy.contact.notes.endpoint : copy.contact.notes.mailto
          }
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  section.section--navy {
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(circle, var(--fg-subtle) 1.5px, transparent 1.5px);
    background-size: 30px 30px;
  }

  /* Decorative only — aria-hidden, so it never duplicates the real
     "Contact" heading for screen readers. Sits behind the content. */
  .contact__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    text-align: center;
    font-family: var(--font-display), Impact, sans-serif;
    text-transform: uppercase;
    font-size: clamp(3.5rem, 16vw, 11rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--fg-subtle);
    opacity: 0.5;
    white-space: nowrap;
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .contact {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .contact__lead {
    max-width: 42ch;
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .email {
    font-family: var(--font-display), Impact, sans-serif;
    font-size: clamp(1rem, 2.6vw, 1.5rem);
    letter-spacing: var(--tracking-tight);
    box-shadow: inset 0 -3px 0 var(--accent);
    word-break: break-all;
    transition: background-color var(--duration-fast) var(--ease-quart-out);
  }

  .email:hover {
    background-color: var(--accent-wash);
  }

  .copy {
    /* Standalone control, so it gets the full 44px target rather than the
       smaller size that inline links are allowed. */
    min-height: 44px;
    padding: var(--space-1) var(--space-4);
    background-color: var(--surface);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-quart-out),
      box-shadow var(--duration-fast) var(--ease-quart-out);
  }

  .copy:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }

  .copy:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--border);
  }

  .socials {
    display: grid;
    gap: 0;
    border: var(--border-width) solid var(--border);
    background-color: var(--surface);
  }

  .social {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* 44px minimum touch target. */
    min-height: 52px;
    padding: var(--space-3) var(--space-4);
    transition: background-color var(--duration-fast) var(--ease-quart-out);
  }

  .socials li + li .social {
    border-top: var(--border-width) solid var(--border);
  }

  .social:hover {
    background-color: var(--sage);
    color: var(--sage-ink);
  }

  .social__label {
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .social__handle {
    font-size: var(--text-sm);
    color: var(--fg-subtle);
    word-break: break-all;
  }

  .social:hover .social__handle {
    color: inherit;
  }

  /* --- Form --- */
  .form {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    background-color: var(--surface);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field-row {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 520px) {
    .field-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  input,
  textarea,
  select {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    background-color: var(--bg);
    border: var(--border-width) solid var(--border);
    color: var(--fg);
    font-size: var(--text-body);
    transition: box-shadow var(--duration-fast) var(--ease-quart-out);
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  input:hover,
  textarea:hover,
  select:hover {
    box-shadow: var(--shadow);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    background-color: var(--accent-wash);
  }

  .error {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-ink);
    /* Stays out of the layout until it has something to say. */
    display: none;
  }

  .error.is-shown {
    display: block;
  }

  .form__note {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }

  .button {
    justify-self: start;
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Copy-to-clipboard for the email address.
  // ---------------------------------------------------------------------------
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const strings = form?.dataset ?? {};
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyLabel = document.querySelector<HTMLElement>('[data-copy-label]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');

  if (copyButton && copyLabel) {
    let resetTimer: number | undefined;

    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        copyLabel.textContent = strings.copyDone ?? 'Copied';
        if (copyStatus) copyStatus.textContent = `${email} copied to clipboard`;
      } catch {
        // Clipboard API needs a secure context and can be blocked entirely.
        copyLabel.textContent = 'Press Ctrl+C';
        if (copyStatus) copyStatus.textContent = strings.copyFailed ?? '';
      }

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        copyLabel.textContent = strings.copyIdle ?? 'Copy';
        if (copyStatus) copyStatus.textContent = '';
      }, 2400);
    });
  }

  // ---------------------------------------------------------------------------
  // Enquiry form. Validates client-side, then either posts to the configured
  // endpoint or hands off to the mail client. `novalidate` disables native
  // bubbles so we can show inline, described errors instead — which screen
  // readers announce properly.
  // ---------------------------------------------------------------------------
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    const showError = (name: string, message: string) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!field || !errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.toggle('is-shown', message !== '');
      if (message) {
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.removeAttribute('aria-invalid');
      }
    };

    form.addEventListener('submit', (event) => {
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const channel = String(data.get('channel') ?? '').trim();
      const format = String(data.get('format') ?? '');
      const volume = String(data.get('volume') ?? '');
      const message = String(data.get('message') ?? '').trim();

      // Deliberately permissive: the browser's own type parsing is stricter
      // than any regex worth maintaining here.
      const emailField = form.elements.namedItem('email') as HTMLInputElement;
      const channelField = form.elements.namedItem('channel') as HTMLInputElement;
      const emailLooksValid = email !== '' && emailField.validity.typeMismatch === false;
      const channelLooksValid = channel === '' || channelField.validity.typeMismatch === false;

      showError('name', name === '' ? (strings.errName ?? '') : '');
      showError(
        'email',
        email === ''
          ? (strings.errEmail ?? '')
          : emailLooksValid
            ? ''
            : (strings.errEmailInvalid ?? '')
      );
      showError(
        'channel',
        channelLooksValid ? '' : (strings.errChannel ?? '')
      );
      showError('message', message === '' ? (strings.errMessage ?? '') : '');

      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }

      // A real endpoint is configured: let the browser post the form itself.
      if (form.getAttribute('action')) return;

      event.preventDefault();
      const to = (copyButton?.dataset.email ?? '').trim();
      const subject = encodeURIComponent(`Editing enquiry from ${name}`);
      const body = encodeURIComponent(
        `${message}\n\nChannel: ${channel || 'not given'}\nMakes: ${format}\nVolume: ${volume}\n\n— ${name}\n${email}`
      );
      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;

      if (status) status.textContent = strings.noteSending ?? '';
    });
  }
</script>
