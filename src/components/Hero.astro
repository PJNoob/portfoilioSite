---
/**
 * The signature moment. Oversized Archivo Black against small body text — the
 * scale contrast is what makes someone stop scrolling, and it is the same
 * poster voice Bhumi already uses elsewhere.
 *
 * Entry motion is choreographed rather than simultaneous: the words rise in
 * sequence out of a mask, then the supporting content follows.
 *
 * The three panels stand in for the work above the fold without loading a
 * single frame of video. They name the formats she actually cuts, so they are
 * doing a job even before cover images exist.
 */
import { profile, copy } from '../data/profile';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__label">{profile.title}</p>

      <h1 class="hero__title">
        {
          profile.headline.map((word, i) => (
            <span class="hero__line">
              {/* The inner span is what actually moves; the outer line clips it,
                  so each word rises out of a mask rather than just fading. */}
              <span class="hero__word" style={`--delay: ${180 + i * 80}ms`}>
                {word}
              </span>
            </span>
          ))
        }
      </h1>

      <p class="hero__tagline">{profile.tagline}</p>

      <div class="hero__actions">
        <a class="button" href="#work">{copy.hero.primaryCta}</a>
        <a class="button button--ghost" href="#contact">{copy.hero.secondaryCta}</a>
      </div>
    </div>

    <ul class="strip" aria-label={copy.hero.stripLabel}>
      {
        profile.heroPanels.map((panel, i) => (
          <li class="strip__item" style={`--delay: ${700 + i * 110}ms; --tilt: ${i % 2 === 0 ? -2.5 : 2}deg`}>
            <span class="strip__ratio">9:16</span>
            <span class="strip__name">{panel}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Fills the viewport minus the header, without the 100vh mobile bug. */
    min-height: calc(100svh - var(--header-height));
    padding-block: var(--space-7) var(--space-8);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    width: 100%;
  }

  /* The type column keeps the bulk of the weight; the strip is support, not a
     second headline competing with the first. */
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-7);
    }
  }

  .hero__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: var(--space-5);
    animation: fade-up var(--duration-slow) var(--ease-expo-out) both;
  }

  .hero__title {
    font-size: var(--text-hero);
    /* Slight optical pull to the left so the large type aligns visually
       rather than mathematically. */
    margin-left: -0.03em;
    margin-bottom: var(--space-5);
  }

  .hero__line {
    display: block;
    /* Masks the word so it rises into view. */
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__word {
    display: inline-block;
    animation: rise var(--duration-slow) var(--ease-expo-out) both;
    animation-delay: var(--delay, 0ms);
  }

  .hero__tagline {
    max-width: 44ch;
    font-size: var(--text-lead);
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
    animation: fade-up var(--duration-slow) var(--ease-expo-out) 440ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    animation: fade-up var(--duration-slow) var(--ease-expo-out) 560ms both;
  }

  /* --- Format strip --- */
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .strip__item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    /* Portrait, because every piece of the work is portrait. */
    aspect-ratio: 9 / 16;
    padding: var(--space-3);
    background-color: var(--surface);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    transform: rotate(var(--tilt));
    animation: fade-up var(--duration-slow) var(--ease-expo-out) both;
    animation-delay: var(--delay, 0ms);
    transition: transform var(--duration) var(--ease-expo-out),
      box-shadow var(--duration) var(--ease-expo-out);
  }

  /* Straightening on hover is the whole joke: the stack snaps into line. */
  .strip:hover .strip__item {
    transform: rotate(0deg);
    box-shadow: var(--shadow-lg);
  }

  .strip__item:nth-child(2) {
    background-color: var(--sage);
    color: var(--sage-ink);
  }

  .strip__item:nth-child(3) {
    background-color: var(--bg-elevated);
  }

  .strip__ratio {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    font-variant-numeric: tabular-nums;
  }

  .strip__name {
    font-family: var(--font-display), Impact, sans-serif;
    font-size: clamp(0.8rem, 2vw, 1.05rem);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    /* Reads bottom-to-top like a clip label on a timeline. */
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  @keyframes rise {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The global reduced-motion block already collapses durations, but these
     elements start at opacity 0 / translated, so land them explicitly. The
     strip keeps its tilt: that is layout, not motion. */
  @media (prefers-reduced-motion: reduce) {
    .hero__label,
    .hero__word,
    .hero__tagline,
    .hero__actions {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .strip__item {
      animation: none;
      opacity: 1;
    }
  }
</style>
