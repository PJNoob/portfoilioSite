---
/**
 * Shared section header: a timecode marker and label above a poster title.
 * `id` is referenced by each section's aria-labelledby.
 *
 * The timecode is the page's running order read as a reel — structure drawn
 * from the work itself rather than a decorative 01 / 02 / 03.
 */
interface Props {
  id: string;
  time: string;
  eyebrow: string;
  title: string;
}

const { id, time, eyebrow, title } = Astro.props;
---

<div class="heading reveal">
  <span class="eyebrow">
    <span class="eyebrow__time">{time}</span>
    <span>{eyebrow}</span>
  </span>
  <h2 id={id}>{title}</h2>
</div>

<style>
  .heading {
    margin-bottom: var(--space-7);
    max-width: var(--measure);
  }
</style>
