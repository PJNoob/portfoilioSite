---
import { education } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="education" aria-labelledby="education-heading">
  <div class="container">
    <SectionHeading id="education-heading" eyebrow="Education" title="Academic background" />

    <ul class="list">
      {
        education.map((item, i) => (
          <li class="entry reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <div class="entry__meta">
              <p class="entry__dates">{item.dateLabel}</p>
              <p class="entry__location">{item.location}</p>
            </div>

            <div class="entry__body">
              <h3 class="entry__degree">{item.degree}</h3>
              <p class="entry__institution">{item.institution}</p>

              {item.grade && (
                <p class="entry__grade">
                  <span class="entry__grade-label">Grade</span>
                  {item.grade}
                </p>
              )}

              <ul class="activities">
                {item.activities.map((activity) => (
                  <li>{activity}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: var(--space-5);
  }

  .entry {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration) var(--ease-expo-out);
  }

  .entry:hover {
    border-color: var(--border-strong);
  }

  @media (min-width: 820px) {
    .entry {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .entry__dates {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .entry__location {
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }

  .entry__degree {
    margin-bottom: var(--space-1);
  }

  .entry__institution {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .entry__grade {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .entry__grade-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .activities {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .activities li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .activities li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 10px;
    height: 1px;
    background-color: var(--border-strong);
  }
</style>
