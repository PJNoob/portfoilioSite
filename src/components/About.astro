---
/**
 * Written as "why is this person safe to hand a channel to", not as a
 * biography. The numbers sit beside the prose because they are the part a
 * creator checks first.
 */
import { profile, copy } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <SectionHeading
      id="about-heading"
      time={copy.about.time}
      eyebrow={copy.about.eyebrow}
      title={copy.about.title}
    />

    <div class="about">
      <div class="about__body reveal">
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <dl class="stats reveal" style="--reveal-delay: 120ms">
        {
          profile.highlights.map((item) => (
            <div class="stats__item">
              <dt class="stats__label">{item.label}</dt>
              <dd class="stats__value">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
  }

  /* Asymmetric split rather than an even two-column grid — the text column
     carries more weight, which keeps the reading line comfortable. */
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .about__body {
    max-width: var(--measure);
  }

  .about__body p + p {
    margin-top: var(--space-4);
  }

  .about__body p {
    color: var(--fg-muted);
  }

  .stats {
    display: grid;
    gap: 0;
    border: var(--border-width) solid var(--border);
    background-color: var(--surface);
    box-shadow: var(--shadow);
  }

  .stats__item {
    padding: var(--space-5);
  }

  .stats__item + .stats__item {
    border-top: var(--border-width) solid var(--border);
  }

  /* The number leads and the label explains it, so the number is set first in
     the visual order even though the label comes first in the markup — a <dl>
     needs its <dt> before its <dd> to stay valid. */
  .stats__value {
    font-family: var(--font-display), Impact, sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--accent-ink);
  }

  .stats__label {
    order: 2;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-top: var(--space-2);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
  }
</style>
