---
/**
 * Written as "why is this person safe to hand a channel to", not as a
 * biography. The numbers sit beside the prose because they are the part a
 * creator checks first.
 */
import { Image } from 'astro:assets';
import { profile, copy } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import portrait from '../assets/profile/portrait.jpg';
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <SectionHeading
      id="about-heading"
      eyebrow={copy.about.eyebrow}
      title={copy.about.title}
    />

    <div class="about">
      <div class="about__body reveal">
        {
          profile.about.map((paragraph, index) => (
            <p
              class:list={[
                {
                  'about__body-line--lead-in': index === 3,
                  'about__body-line--emphasis': index === 4,
                  'about__body-line--addendum': index === 5,
                  'about__body-line--closing': index === 6,
                },
              ]}
            >
              {paragraph}
            </p>
          ))
        }
      </div>

      <div class="about__side reveal" style="--reveal-delay: 120ms">
        {/* The print tilts like a photo tossed onto a desk, and straightens
            flat on hover. It doesn't need to match the text column's height: a photo
            sitting shorter or taller than adjacent copy reads as normal,
            which a stack of two card-shapes trying to add up to the same
            height did not. */}
        <figure class="print">
          <div class="print__photo">
            <Image
              src={portrait}
              alt={`${profile.name}, ${profile.title}`}
              widths={[260, 390, 520]}
              sizes="(min-width: 900px) 260px, 50vw"
              loading="lazy"
            />
          </div>
          <figcaption class="print__caption">
            <span class="print__name">{profile.name}</span>
            <span class="print__role">{profile.title}</span>
          </figcaption>
        </figure>
      </div>
    </div>

    {/* Full-width now rather than stacked in the side column — its own
        content (three rows of numbers) was already taller than the bio
        text on its own, so no side-column height could ever have matched
        without either column faking its own content. A horizontal strip
        sidesteps the comparison entirely. */}
    <dl class="stats reveal" style="--reveal-delay: 160ms">
      {
        profile.highlights.map((item) => (
          <div class="stats__item">
            <dt class="stats__label">{item.label}</dt>
            <dd class="stats__value">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
  }

  /* Asymmetric split rather than an even two-column grid — the text column
     carries more weight, which keeps the reading line comfortable. */
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .about__body {
    max-width: var(--measure);
  }

  .about__body p + p {
    margin-top: var(--space-4);
  }

  .about__body p {
    color: var(--fg-muted);
  }

  /* The lead-in sits a little further from the intro paragraphs above it —
     it's setting up the punchline block, not continuing the same thought. */
  .about__body p.about__body-line--lead-in {
    margin-top: var(--space-5);
  }

  /* The punchline: indented and rendered as a bordered block in full
     foreground ink, so the three-beat rhythm ("stop. feel. remember.")
     reads as the point of the section rather than another sentence in it. */
  .about__body p.about__body-line--emphasis {
    margin-top: var(--space-4);
    padding-left: var(--space-5);
    border-left: var(--border-width) solid var(--accent-ink);
    color: var(--fg);
    font-family: var(--font-display), Impact, sans-serif;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
  }

  /* The coda hangs off the punchline as a quieter aside — indented further,
     smaller, in accent ink rather than full ink. */
  .about__body p.about__body-line--addendum {
    margin-top: var(--space-2);
    padding-left: calc(var(--space-5) + var(--space-3));
    color: var(--accent-ink);
    font-size: var(--text-sm);
    font-style: italic;
  }

  /* The closing line is the sign-off, set apart with extra space above and
     full-weight ink so it reads as a distinct final beat, not a fourth
     intro paragraph. */
  .about__body p.about__body-line--closing {
    margin-top: var(--space-5);
    color: var(--fg);
    font-weight: 600;
  }

  /* --- Portrait print --- */
  .print {
    width: min(260px, 70%);
    padding: var(--space-2) var(--space-2) var(--space-3);
    background-color: var(--surface);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    transform: rotate(-3deg);
    transition: transform var(--duration) var(--ease-expo-out),
      box-shadow var(--duration) var(--ease-expo-out);
  }

  .print:hover {
    transform: rotate(0deg);
    box-shadow: var(--shadow-lg);
  }

  .print__photo {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--bg-elevated);
  }

  .print__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .print__caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--space-2);
  }

  .print__name {
    font-family: var(--font-display), Impact, sans-serif;
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .print__role {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Full-width 3-up strip, not the stacked-rows shape it used to sit in —
     it sits below the two-column split entirely now. */
  .stats {
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: var(--border-width) solid var(--border);
    background-color: var(--surface);
    box-shadow: var(--shadow);
  }

  .stats__item {
    padding: var(--space-5);
  }

  .stats__item + .stats__item {
    border-left: var(--border-width) solid var(--border);
  }

  /* The number leads and the label explains it, so the number is set first in
     the visual order even though the label comes first in the markup — a <dl>
     needs its <dt> before its <dd> to stay valid. */
  .stats__value {
    font-family: var(--font-display), Impact, sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--accent-ink);
  }

  .stats__label {
    order: 2;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-top: var(--space-2);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
  }
</style>
