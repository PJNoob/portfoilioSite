---
/**
 * The single page shell: fonts, metadata, theme bootstrap, and chrome.
 */
import { Font } from 'astro:assets';
import { profile, socials, navLinks, copy } from '../data/profile';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${profile.name} — ${profile.title}`, description = profile.metaDescription } =
  Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Falls back gracefully so
// a missing config never breaks the build.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;

// Structured data helps search engines render a richer result for her name.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  url: canonical,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  knowsAbout: ['Video editing', 'Short-form video', 'Content strategy', 'Social media marketing'],
  sameAs: socials.filter((s) => !s.href.startsWith('mailto:')).map((s) => s.href),
};
---

{/* `no-js` is removed by the inline script below; it gates the CSS fallback
    that keeps scroll-reveal content visible when JavaScript is unavailable. */}
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Self-hosted, subset and preloaded. No external font request is made,
        and the fallback metrics Astro emits keep layout shift at ~0. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {/*
      Theme bootstrap. `is:inline` is essential here — without it Astro would
      bundle and defer this script, which means it would run after first paint
      and the user would see a flash of the wrong theme on every load.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            root.setAttribute('data-theme', saved);
          }
          // No saved choice: leave the attribute off so the CSS
          // prefers-color-scheme media query decides.
        } catch (e) {
          /* localStorage can throw in private mode; the OS default still applies. */
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    <Nav />

    {/*
      The playhead: scroll position read as a timeline, which is the instrument
      this whole site is about. Decorative — the nav already gives every one of
      these sections a real, reachable link — so it is hidden from assistive
      tech and from viewports too narrow to spare the room.
    */}
    <div class="playhead" aria-hidden="true" data-playhead>
      <span class="playhead__fill" data-playhead-fill></span>
      <ul class="playhead__marks">
        {
          navLinks.map((link) => (
            <li class="playhead__mark" data-playhead-mark={link.href}>
              <span class="playhead__time">{link.time}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ---------------------------------------------------------------------
      // Scroll reveal + scrollspy + playhead. Astro bundles, minifies and
      // defers this.
      // ---------------------------------------------------------------------
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Reveal on scroll ---
      const revealTargets = document.querySelectorAll<HTMLElement>('.reveal');

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        // Show everything immediately rather than animating it in.
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              // Fire once — no need to keep observing.
              revealObserver.unobserve(entry.target);
            }
          },
          // Trigger slightly before the element reaches the bottom edge so the
          // animation is already underway when it comes into view.
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );
        revealTargets.forEach((el) => revealObserver.observe(el));
      }

      // --- Scrollspy: highlight the nav link for the section in view ---
      const navLinkEls = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
      );
      const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-playhead-mark]'));
      const sections = navLinkEls
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((el): el is HTMLElement => el !== null);

      if (sections.length && 'IntersectionObserver' in window) {
        const setActive = (id: string) => {
          for (const link of navLinkEls) {
            const isActive = link.hash === `#${id}`;
            link.classList.toggle('is-active', isActive);
            if (isActive) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          }
          for (const mark of marks) {
            mark.classList.toggle('is-active', mark.dataset.playheadMark === `#${id}`);
          }
        };

        const spyObserver = new IntersectionObserver(
          (entries) => {
            // Pick the entry closest to the top of the viewport so fast
            // scrolling through several sections still lands on the right one.
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible[0]) setActive(visible[0].target.id);
          },
          // A band across the upper-middle of the viewport.
          { rootMargin: '-20% 0px -70% 0px' }
        );
        sections.forEach((section) => spyObserver.observe(section));
      }

      // --- Playhead fill: how far through the page you are ---
      const fill = document.querySelector<HTMLElement>('[data-playhead-fill]');

      if (fill) {
        const syncPlayhead = () => {
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
          fill.style.setProperty('--progress', String(Math.min(1, Math.max(0, progress))));
        };
        syncPlayhead();
        window.addEventListener('scroll', syncPlayhead, { passive: true });
        window.addEventListener('resize', syncPlayhead, { passive: true });
      }
    </script>

    <style>
      .playhead {
        position: fixed;
        top: 50%;
        right: clamp(0.75rem, 2vw, 1.5rem);
        z-index: 90;
        display: none;
        grid-template-columns: auto auto;
        align-items: stretch;
        gap: var(--space-3);
        height: 44vh;
        transform: translateY(-50%);
      }

      /* Only shown where there is room beside the 72rem container. Below that
         it would sit on top of the content it is describing. */
      @media (min-width: 1240px) {
        .playhead {
          display: grid;
        }
      }

      /* The track itself, with the played portion filled from the top. */
      .playhead__fill {
        position: relative;
        width: var(--border-width);
        background-color: var(--border);
        opacity: 0.25;
      }

      .playhead__fill::after {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: calc(var(--progress, 0) * 100%);
        background-color: var(--accent);
        opacity: 1;
      }

      .playhead__marks {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .playhead__time {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--fg-subtle);
        font-variant-numeric: tabular-nums;
        transition: color var(--duration-fast) var(--ease-quart-out);
      }

      .playhead__mark.is-active .playhead__time {
        color: var(--accent-ink);
      }
    </style>
  </body>
</html>
